# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-here-with-openssl-rand-base64-32"

# Whop (server-side only — never expose to client)
WHOP_API_KEY=""
WHOP_WEBHOOK_SECRET=""
